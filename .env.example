# === Лавбрю: переменные окружения ===
# Скопируй в .env и заполни. Без .env проект не стартует (нужна база).

# Подключение к MySQL (обязательно). Примеры:
#   Docker Compose из репо:  mysql://lavbrew:lavbrew@localhost:3306/lavbrew
#   Timeweb/Reg.ru/др. VPS:  mysql://USER:PASS@HOST:3306/DBNAME
DATABASE_URL=mysql://user:password@host:3306/lavbrew

# Идентификаторы приложения (можно оставить как есть для пилота)
APP_ID=local
APP_SECRET=local
VITE_APP_ID=local

# Порт сервера (необязательно, по умолчанию 3000)
# PORT=3000

# --- Quick Resto и Telegram НЕ нужны в .env ---
# Они настраиваются через админку: /admin → Настройки.
# Без них всё работает в демо-режиме (бонусы/QR отключены,
# уведомления о заявках просто не отправляются).
